# TLE data source. "celestrak" (default, no auth) or "space-track".
TLE_SOURCE=celestrak

# Optional: Space-Track credentials (only needed if TLE_SOURCE=space-track).
# Sign up at https://www.space-track.org
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# Cache TTL for TLE data, in minutes. CelesTrak asks clients to cache for 2+ hours.
TLE_CACHE_TTL_MINUTES=120

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me

# Bind host/port for gunicorn / flask run
HOST=127.0.0.1
PORT=5000
